# Direct Google Gemini API connection through the AI SDK.
GEMINI_API_KEY=
AI_MODEL=gemini-3.6-flash
AI_REASONING_EFFORT=low

# GOOGLE_GENERATIVE_AI_API_KEY is also accepted as an alternative key name.

# eGov SSO hackathon sandbox. Obtain these values from the official eGov API
# developer portal. The partner secret and session secret are server-only.
EGOV_SSO_BASE_URL=https://your-egov-sso-gateway.example
EGOV_SSO_PARTNER_CODE=
EGOV_SSO_PARTNER_SECRET=
EGOV_SSO_PARTNER_NAME=eGov Agent
EGOV_SSO_CALLBACK_URL=http://localhost:3000/api/auth/egov/callback
EGOV_SESSION_SECRET=
EGOV_SSO_DEMO_MODE=true

# Optional response-path overrides. The defaults match the current catalog.
EGOV_SSO_ACCESS_TOKEN_PATH=access_token
EGOV_SSO_SUBJECT_PATH=data.uniqid
EGOV_SSO_FIRST_NAME_PATH=data.first_name
EGOV_SSO_MIDDLE_NAME_PATH=data.middle_name
EGOV_SSO_LAST_NAME_PATH=data.last_name
EGOV_SSO_PCN_PATH=data.pcn

# Telegram channel adapter. Never commit a real bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=eGovAgentBot

# Public app origin for document links sent through Telegram.
APP_BASE_URL=http://localhost:3000

# Optional local route used by `npm run telegram:dev`.
TELEGRAM_LOCAL_WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/telegram
