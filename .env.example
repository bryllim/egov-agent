# eGov AI hackathon gateway. The access code is server-only.
EGOV_AI_BASE_URL=https://platforms-api.e.gov.ph/egov-ai
EGOV_AI_ACCESS_CODE=

# DBM Compass hackathon gateway. Keep the API key on the server.
COMPASS_BASE_URL=https://platforms-api.e.gov.ph/compass
COMPASS_API_KEY=

# eReport hackathon gateway. The access code is exchanged for a short-lived
# bearer token on the server. The view token is only needed for case retrieval.
EREPORT_BASE_URL=https://platforms-api.e.gov.ph/ereport
EREPORT_ACCESS_CODE=
EREPORT_VIEW_TOKEN=
# Optional exact report-type code from the live eReport dataset.
EREPORT_FLOOD_REPORT_TYPE=

# eMessage SMS gateway. Keep the service token server-only. Sending is gated by
# a reviewed draft and explicit user action in the chat flow.
EMESSAGE_BASE_URL=https://platforms-api.e.gov.ph/emessage
EMESSAGE_AUTH_TOKEN=

# eGovPay gateway. Never expose the merchant token or compute the request
# digest in browser code. Use the credential issued for the hackathon.
EGOVPAY_BASE_URL=https://platforms-api.e.gov.ph/egovpay
# Paste the 32-character Token shown by the portal. The app adds the test_
# prefix required by eGovPay's sandbox API.
EGOVPAY_MERCHANT_TOKEN=
EGOVPAY_SETTLEMENT_TEMPLATE_UUID=
# Optional overrides; defaults use APP_BASE_URL.
EGOVPAY_APP_URL=http://localhost:3000
EGOVPAY_REDIRECT_URL=
EGOVPAY_CALLBACK_URL=

# eGov SSO hackathon sandbox. Obtain these values from the official eGov API
# developer portal. The partner secret and session secret are server-only.
EGOV_SSO_BASE_URL=https://your-egov-sso-gateway.example
EGOV_SSO_PARTNER_CODE=
EGOV_SSO_PARTNER_SECRET=
EGOV_SSO_PARTNER_NAME=eGov Agent
EGOV_SSO_CALLBACK_URL=http://localhost:3000/api/auth/egov/callback
EGOV_SESSION_SECRET=
EGOV_SSO_DEMO_MODE=true

# Optional response-path overrides. The defaults match the current catalog.
EGOV_SSO_ACCESS_TOKEN_PATH=access_token
EGOV_SSO_SUBJECT_PATH=data.uniqid
EGOV_SSO_FIRST_NAME_PATH=data.first_name
EGOV_SSO_MIDDLE_NAME_PATH=data.middle_name
EGOV_SSO_LAST_NAME_PATH=data.last_name
EGOV_SSO_PCN_PATH=data.pcn

# Telegram channel adapter. Never commit a real bot token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_BOT_USERNAME=eGovAgentBot

# Public app origin for document links sent through Telegram.
APP_BASE_URL=http://localhost:3000

# Optional local route used by `npm run telegram:dev`.
TELEGRAM_LOCAL_WEBHOOK_URL=http://127.0.0.1:3000/api/webhooks/telegram
